# Copy to .env in the project root. Restart mashang_server.exe after editing.
# Chat Completions compatible provider: full endpoint URL, including path.
LLM_API_URL=https://api.deepseek.com/chat/completions
LLM_MODEL=deepseek-flash
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
# DeepSeek: use direct answers within the short classroom Q&A budget.
# Leave empty for providers that do not support the thinking parameter.
LLM_THINKING=disabled
